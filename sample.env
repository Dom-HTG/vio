# vio model provider configuration.
# Copy this file to .env and fill in your values.

# Endpoint base URL.
# DeepSeek default: https://api.deepseek.com
# Other OpenAI-compatible servers: use your own, e.g.
#   Ollama        http://localhost:11434/v1
#   LM Studio     http://localhost:1234/v1
#   OpenRouter    https://openrouter.ai/api/v1
MODEL_BASE_URL=https://api.deepseek.com

# API key / bearer token.
# Required by the DeepSeek preset. Leave empty for keyless local endpoints.
MODEL_API_KEY=

# Model identifier sent in requests.
# DeepSeek: deepseek-chat or deepseek-reasoner
MODEL_NAME=deepseek-chat
